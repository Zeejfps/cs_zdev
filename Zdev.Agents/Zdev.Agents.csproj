<Project Sdk="Microsoft.NET.Sdk">

    <!-- Coding agents run through their native CLIs: the Agent Client Protocol client, agent
         presets, and the command line a terminal agent is started with. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- For the job object an agent's processes are held in on Windows. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Zdev.Agents.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zdev.Common\Zdev.Common.csproj" />
    </ItemGroup>

</Project>
