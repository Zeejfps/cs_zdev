<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Compiles the vendored XtermSharp sources. Upstream's own csproj does not build under a
        current SDK: its InternalsVisibleTo AssemblyAttribute item carries Visible="False"
        metadata, which newer SDKs pass through as a second constructor argument. The project file
        is therefore ours.

        ..\XtermSharp\ is a fork, not a verbatim copy. It started as a clone of upstream
        XtermSharp/master (December 2020) and is patched in place; every divergence from that clone
        is listed in ..\XtermSharp\PATCHES.md, so a diff against a fresh clone stays legible.
        Gaps not yet patched are recorded in docs/xtermsharp-known-gaps.md.

        net10.0, so the trimmer and the AOT analyzers see these sources like every other project
        in the app; a netstandard2.0 library fails a trimmed publish with NETSDK1124. NStack.Core
        declares its own System.Rune, which on .NET Core 3.0 onwards collides with System.Text.Rune
        wherever the bare name is used -

            XtermSharp/SelectionService.cs:175             Rune.IsLetterOrDigit (cd.Rune)
            XtermSharp/InputHandlers/InputHandler.cs:1312  Rune.DecodeRune (x)

        These sources mean NStack's, so the Using item below aliases the name to it rather than
        patching the fork.
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>XtermSharp</AssemblyName>
        <RootNamespace>XtermSharp</RootNamespace>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS8981;SYSLIB0011</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\XtermSharp\**\*.cs" />
        <Using Include="System.Rune" Alias="Rune" />
    </ItemGroup>

    <ItemGroup>
        <!--
            NStack flows to every consumer of this project, and with it NStack's System.Rune, which
            is ambiguous with System.Text.Rune wherever the bare name is used. PrivateAssets would
            hide the type from consumers but also drop the assembly from their deps.json, and the
            engine then throws FileNotFoundException while building its first buffer. Consumers
            alias the name instead - see the Using item in Zdev.Terminal.Vt.csproj.
        -->
        <PackageReference Include="NStack.Core" Version="0.12.0" />
    </ItemGroup>

</Project>
